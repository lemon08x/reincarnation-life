{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".test-dist",
    "lib": [
      "ES2020",
      "DOM"
    ]
  },
  "include": [
    "assets/scripts/core/**/*.ts",
    "assets/scripts/content/**/*.ts",
    "assets/scripts/app/**/*.ts",
    "tests/**/*.ts"
  ]
}
